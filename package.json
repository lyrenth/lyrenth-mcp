{
  "name": "lyrenth-mcp",
  "version": "0.1.6",
  "mcpName": "com.lyrenth/lyrenth-mcp",
  "description": "Model Context Protocol server for Lyrenth: read any web page as a clean AIDocument.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "lyrenth-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "check:version": "node scripts/check-version.mjs",
    "check:tools": "node scripts/check-tools.mjs",
    "check:published": "node scripts/check-published.mjs",
    "bump": "node scripts/bump-version.mjs",
    "preflight": "npm run build && npm run check:version && npm run check:tools",
    "sync:mirror": "bash scripts/sync-public-mirror.sh",
    "start:http": "node dist/http.js",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "lyrenth",
    "aidocument",
    "web",
    "reader",
    "search-index",
    "index",
    "agent"
  ],
  "homepage": "https://lyrenth.com",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.5.0"
  }
}
